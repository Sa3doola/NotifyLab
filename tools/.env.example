# Copy to tools/.env (git-ignored) and fill in. Never commit the real file.

# developer.apple.com ▸ Account ▸ Membership details
TEAM_ID=ABCDE12345
# developer.apple.com ▸ Keys ▸ your APNs key
KEY_ID=XYZ9876543
# The .p8 you downloaded (once!). Path is relative to the NotifyLab folder.
KEY_PATH=secrets/AuthKey_XYZ9876543.p8

BUNDLE_ID=com.yourco.notifylab
# sandbox for Xcode/Debug builds, production for TestFlight/App Store builds
APNS_ENV=sandbox

# Copy from the app: Orders tab ▸ APNs device token / Calls tab ▸ VoIP token
DEVICE_TOKEN=
VOIP_TOKEN=
# Optional: newer notifications with the same id replace older ones
COLLAPSE_ID=
# Optional: UNIX time (seconds) after which APNs stops trying. 0 = try once, don't store.
EXPIRATION=

# FCM (Part 3): Firebase ▸ Project settings ▸ Service accounts ▸ Generate new private key
FCM_SERVICE_ACCOUNT=secrets/firebase-service-account.json
# Copy from the app: Orders tab ▸ FCM registration token
FCM_TOKEN=
